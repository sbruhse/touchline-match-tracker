{
  "name": "football-match-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:pwa-assets": "pwa-assets-generator --config pwa-assets.config.ts",
    "test": "vitest run",

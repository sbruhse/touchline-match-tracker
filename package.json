    "test:watch": "vitest",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.5.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "selenium-webdriver": "^4.49.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.0.8"
  }
}
